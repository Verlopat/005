{
  "_comment": "Template Fabric Gateway connection profile for src/ledger/fabric_gateway.py. Copy to .phase2_runtime/fabric-gateway.json (git-ignored), fill in the TLS root certs generated by network-up.sh, and set config/phase2.example.yaml's ledger.gateway_config to that path.",
  "name": "phase2-securitylog-network",
  "version": "1.0.0",
  "client": {
    "organization": "SecurityOrg",
    "connection": {
      "timeout": { "peer": { "endorser": "300" } }
    }
  },
  "organizations": {
    "SecurityOrg": {
      "mspid": "SecurityOrgMSP",
      "peers": ["peer0.security.phase2.local", "peer1.security.phase2.local"],
      "certificateAuthorities": ["ca.security.phase2.local"]
    }
  },
  "peers": {
    "peer0.security.phase2.local": {
      "url": "grpcs://localhost:7051",
      "tlsCACerts": { "path": "REPLACE_WITH_PATH/crypto-config/peerOrganizations/security.phase2.local/tlsca/tlsca.security.phase2.local-cert.pem" },
      "grpcOptions": { "ssl-target-name-override": "peer0.security.phase2.local" }
    },
    "peer1.security.phase2.local": {
      "url": "grpcs://localhost:7151",
      "tlsCACerts": { "path": "REPLACE_WITH_PATH/crypto-config/peerOrganizations/security.phase2.local/tlsca/tlsca.security.phase2.local-cert.pem" },
      "grpcOptions": { "ssl-target-name-override": "peer1.security.phase2.local" }
    }
  },
  "certificateAuthorities": {
    "ca.security.phase2.local": {
      "url": "https://localhost:7054",
      "caName": "ca-security",
      "tlsCACerts": { "path": "REPLACE_WITH_PATH/crypto-config/peerOrganizations/security.phase2.local/ca/ca.security.phase2.local-cert.pem" },
      "httpOptions": { "verify": true }
    }
  },
  "channel_name": "securitylogchannel",
  "chaincode_name": "securitylog"
}
